  "rules": {
    "regra_co2": {
      "name": "Ventilar com CO2 alto",
      "enabled": true,
      "logic": "AND",
      "conditions": [
        {
          "source": "sensor",
          "path": "zones/cozinha/sensors/cozinha_co2/value",
          "operator": ">",
          "value": 1000
        }
      ],
      "actions": [
        {
          "type": "actuator",
          "path": "zones/cozinha/actuators/cozinha_fan/state",
          "state": true
        }
      ]
    },
    "regra_intrusao": {
      "name": "Alerta de intrusão à noite",
      "enabled": true,
      "logic": "AND",
      "conditions": [
        {
          "source": "sensor",
          "path": "zones/entrada/sensors/entrada_ir/value",
          "operator": "==",
          "value": true
        },
        {
          "source": "external",
          "path": "external/sun/isDay",
          "operator": "==",
          "value": false
        }
      ],
      "actions": [
        {
          "type": "alert",
          "message": "Movimento na entrada durante a noite",
          "level": "danger"
        }
      ]
    },
    "regra_luz": {
      "name": "Luz da entrada quando está escuro",
      "enabled": true,
      "logic": "AND",
      "conditions": [
        {
          "source": "sensor",
          "path": "zones/entrada/sensors/entrada_ldr/value",
          "operator": "<",
          "value": 150
        }
      ],
      "actions": [
        {
          "type": "actuator",
          "path": "zones/entrada/actuators/entrada_luz/state",
          "state": true
        }
      ]
    }
  },
